{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "tasks": {
    "dev": "deno run -A vite",
    "build": "deno run -A vite build",
    "preview": "deno run -A vite preview",
    "test": "deno test -A src/",
    "lint:css": "deno run --allow-env --allow-sys --allow-read --allow-write stylelint src/**/*.css",
    "lint:css:fix": "deno run --allow-env --allow-sys --allow-read --allow-write stylelint src/**/*.css --fix",
    "deploy": "deno run -A wrangler deploy"
  },
  "imports": {
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "lucide-preact": "npm:lucide-preact@^0.475.0",
    "preact": "npm:preact@^10.29.8",
    "preact/hooks": "npm:preact@^10.29.8/hooks",
    "stylelint": "npm:stylelint@^16.26.1",
    "stylelint-config-standard": "npm:stylelint-config-standard@^37.0.0",
    "vite": "npm:vite@^6.4.3",
    "wrangler": "npm:wrangler@^4.131.1"
  }
}
