{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "preview": "deno run -A --node-modules-dir=auto npm:vite preview",
    "test": "deno test -A src/"
  },
  "imports": {
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.6",
    "@std/assert": "jsr:@std/assert@1",
    "lucide-preact": "npm:lucide-preact@^0.475.0",
    "preact": "npm:preact@^10.26.4",
    "preact/hooks": "npm:preact@^10.26.4/hooks",
    "vite": "npm:vite@^6.2.0"
  }
}
